<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/display.css" />
    <title>Product Details</title>
</head>
<body>
        {{#each data}}
    <main class="product-card">
        <img class="product-image" src="{{image}}" alt="{{name}}">
        <p class="product-name">{{name}}</p>
        <p class="product-price">{{price}}</p>

        <div class="product-actions">
            <form action="/singlepage/{{_id}}" method="post">
                <button class="product-button" type="submit">View</button>
            </form>
            <a class="product-button" href="/update/{{_id}}">Update</a>
            <form action="/delete/{{_id}}" method="post" onsubmit="return confirm('Delete this product?')">
                <button class="product-button product-button-danger" type="submit">Delete</button>
            </form>
        </div>
        
    </main>
    
        {{/each}}
</body>
</html>
