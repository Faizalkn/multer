<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Product Form</title>
    <link rel="stylesheet" href="/style.css" />
  </head>
  <body>
    <div class="container">
      <form class="product-form" action="/display" method="POST" enctype="multipart/form-data">
        <h2>Add Product</h2>

        <div class="field-group">
          <label for="name">Product Name</label>
          <input id="name" type="text" name="name" placeholder="Enter product name" value="phone" />
        </div>

        <div class="field-group">
          <label for="price">Price</label>
          <input id="price" type="text" name="price" placeholder="Enter price" value="68000" />
        </div>

        <div class="field-group">
          <label for="image">Product Image</label>
          <input id="image" type="file" name="image" />
        </div>

        <button type="submit">Submit</button>

      </form>

      <a href="/product">Product</a>
    </div>
  </body>
</html>